generator client {
  provider = "prisma-client"
   output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User { 
  id    Int     @id @default(autoincrement()) 
  clerkId String  @unique
  email String  @unique
  role UserRole @default(USER)
  firstName String?
  lastName String?
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
} 

enum UserRole {
  USER
  ADMIN
}
